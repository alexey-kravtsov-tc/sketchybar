#!/bin/sh

# Clear old items
sketchybar --remove '/.*/' 2>/dev/null

# Bar Configuration (Bottom position for AeroSpace compatibility)
sketchybar --bar position=bottom \
                  height=20 \
                  color=0xff1a1a1a \
                  border_color=0xff333333 \
                  border_width=0 \
                  topmost=window \
                  sticky=on \
                  padding_left=0 \
                  padding_right=0

# Default styling for "pill capsule" widgets
sketchybar --default background.color=0xff333333 \
                      background.corner_radius=4 \
                      background.height=16 \
                      background.padding_left=3 \
                      background.padding_right=3 \
                      label.color=0xffeeeeee \
                      label.font="Hack Nerd Font:Bold:12.0" \
                      icon.font="Hack Nerd Font:Bold:12.0" \
                      label.padding_left=4 \
                      label.padding_right=4

# --- LEFT SIDE ITEMS ---

# AeroSpace workspace handler (invisible)
sketchybar --add event aerospace_workspace_change
sketchybar --add item aerospace_handler left \
           --set aerospace_handler script="$CONFIG_DIR/plugins/aerospace.sh" \
                                 drawing=off
sketchybar --subscribe aerospace_handler aerospace_workspace_change routine

# --- CENTER ITEMS ---

# Gradle Daemons monitor (hidden unless active builds are running).
# Popup of log previews only toggles on mouse click (off by default).
sketchybar --add event gradle_update
sketchybar --add item gradle center \
           --set gradle update_freq=10 \
                          script="$CONFIG_DIR/plugins/gradle/gradle.sh" \
                          drawing=off \
                          popup.drawing=off \
                          icon="" \
                          label.font="Hack Nerd Font:Bold:12.0" \
                          label.color=0xffeeeeee \
                          popup.align=center \
                          popup.blur_radius=8 \
                          popup.background.color=0xff111111 \
                          popup.width=480
sketchybar --subscribe gradle routine forced system_woke gradle_update mouse.clicked

# --- RIGHT SIDE ITEMS ---

# Clock
sketchybar --add item clock right \
           --set clock update_freq=60 \
                        script="$CONFIG_DIR/plugins/clock.sh" \
                        popup.align=center \
                        popup.blur_radius=8 \
                        popup.background.color=0xff222222 \
                        popup.width=600
sketchybar --subscribe clock mouse.entered mouse.exited mouse.clicked

# Calendar popup items
for i in $(seq 0 9); do
  sketchybar --add item "clock_event_$i" popup.clock \
             --set "clock_event_$i" \
                   drawing=off \
                   icon="·" \
                   icon.padding_left=6 \
                   icon.padding_right=4 \
                   label.padding_right=6 \
                   label.width=580 \
                   width=600 \
                   background.height=20
done

# Battery
sketchybar --add item battery right \
           --set battery update_freq=30 \
                           script="$CONFIG_DIR/plugins/battery.sh"
sketchybar --subscribe battery mouse.entered mouse.exited

# WiFi
sketchybar --add item wifi right \
           --set wifi update_freq=10 \
                          script="$CONFIG_DIR/plugins/wifi.sh" \
                          popup.align=center \
                          popup.blur_radius=8 \
                          popup.background.color=0xff222222 \
                          popup.width=280
sketchybar --subscribe wifi mouse.entered mouse.exited routine

# WiFi popup items (up to 20 nearby networks).
for i in $(seq 0 19); do
  sketchybar --add item "wifi_popup_$i" popup.wifi \
             --set "wifi_popup_$i" \
                   drawing=off \
                   label.font="Hack Nerd Font:Bold:12.0" \
                   label.color=0xffeeeeee \
                   label.padding_left=8 \
                   label.padding_right=8 \
                   label.padding_top=3 \
                   label.padding_bottom=3 \
                   background.color=0xff222222 \
                   background.padding_left=2 \
                   background.padding_right=2 \
                   background.padding_top=2 \
                   background.padding_bottom=2 \
                   background.corner_radius=4 \
                   label.width=260 \
                   width=276 \
                   script="$CONFIG_DIR/plugins/wifi.sh"
  sketchybar --subscribe "wifi_popup_$i" mouse.entered mouse.exited mouse.clicked
done

# Now Playing
# Main media item: shows currently playing track title/artist + popup panel on click
sketchybar --add item media right \
           --set media update_freq=10 \
                       script="$CONFIG_DIR/plugins/media.sh" \
                       label.padding_left=6 \
                       icon.padding_right=6 \
                       popup.align=center \
                       popup.blur_radius=8 \
                       popup.background.color=0xff222222 \
                       popup.width=260
sketchybar --subscribe media media_change routine mouse.entered mouse.exited mouse.clicked

# Popup rows inside `media` popup: previous / play-pause / next
for row in 0 1 2; do
  sketchybar --add item "media_popup_${row}" popup.media \
             --set "media_popup_${row}" \
                   drawing=off \
                   label.font="Hack Nerd Font:Bold:14.0" \
                   label.color=0xffeeeeee \
                   label.align=center \
                   label.padding_left=10 \
                   label.padding_right=10 \
                   label.padding_top=4 \
                   label.padding_bottom=4 \
                    background.color=0xff222222 \
                    background.corner_radius=4 \
                    background.padding_left=4 \
                    background.padding_right=4 \
                    width=240
  sketchybar --subscribe "media_popup_${row}" mouse.entered mouse.exited
done

# Keyboard Layout
sketchybar --add item kb_layout right \
           --set kb_layout update_freq=5 \
                           script="$CONFIG_DIR/plugins/kb_layout.sh"
sketchybar --subscribe kb_layout mouse.entered mouse.exited mouse.clicked

# Volume + Audio Output (merged):
#   State 1: text label "{output} >> {volume}%" (no slider, no popup).
#   State 2 (click): text blanked, slider visible, popup lists output devices
#           with current marked (  bold ). Auto-collapses after pointer
#           leaves the control for HOLD_SECONDS.

# Textual bar item; also acts as the popup anchor.
sketchybar --add item volume right \
    --set volume \
        update_freq=10 \
        script="$CONFIG_DIR/plugins/volume.sh" \
        icon.drawing=off \
        label="" \
        label.font="Hack Nerd Font:Bold:12.0" \
        label.color=0xffeeeeee \
        label.padding_left=4 \
        label.padding_right=4 \
        popup.align=center \
        popup.blur_radius=8 \
        popup.background.color=0xff222222 \
        popup.width=300

# Slider (hidden by default; appears when the text item is clicked).
sketchybar --add slider volume_slider right 200 \
    --set volume_slider script="$CONFIG_DIR/plugins/volume.sh" \
        slider.knob="●" \
        slider.background.color=0xff555555 \
        slider.height=12 \
        drawing=off

# Output device popup rows (parented to the merged volume item).
for i in $(seq 0 19); do
  sketchybar --add item "volume_output_$i" popup.volume \
      --set "volume_output_$i" \
          drawing=off \
          script="$CONFIG_DIR/plugins/volume.sh" \
          icon="·" \
          icon.padding_left=6 \
          icon.padding_right=6 \
          label.padding_right=6 \
          label.width=280 \
          width=300 \
          background.height=20
  sketchybar --subscribe "volume_output_$i" mouse.entered mouse.exited
done

sketchybar --subscribe volume mouse.clicked mouse.entered mouse.exited routine volume_change
sketchybar --subscribe volume_slider mouse.clicked mouse.entered mouse.exited volume_change

# Mic Input + Level (merged):
#   State 1: text label "{mic level}% << {input source}".
#   State 2 (click): text blanked, mic_slider visible, popup lists
#           input devices with current marked (  + bold ).
#   Auto-collapses after pointer leaves the control for HOLD_SECONDS.

sketchybar --add item mic right \
    --set mic \
        update_freq=10 \
        script="$CONFIG_DIR/plugins/mic_input.sh" \
        icon.drawing=off \
        label="" \
        label.font="Hack Nerd Font:Bold:12.0" \
        label.color=0xffeeeeee \
        label.padding_left=4 \
        label.padding_right=4 \
        popup.align=center \
        popup.blur_radius=8 \
        popup.background.color=0xff222222 \
        popup.width=300

sketchybar --add slider mic_slider right 200 \
    --set mic_slider script="$CONFIG_DIR/plugins/mic_input.sh" \
        slider.knob="●" \
        slider.background.color=0xff555555 \
        slider.height=12 \
        drawing=off

# Mic input popup rows (parented to the merged mic item).
for i in $(seq 0 19); do
  sketchybar --add item "mic_input_$i" popup.mic \
      --set "mic_input_$i" \
          drawing=off \
          script="$CONFIG_DIR/plugins/mic_input.sh" \
          icon="·" \
          icon.padding_left=6 \
          icon.padding_right=6 \
          label.padding_right=6 \
          label.width=280 \
          width=300 \
          background.height=20
  sketchybar --subscribe "mic_input_$i" mouse.entered mouse.exited
done

sketchybar --subscribe mic mouse.clicked mouse.entered mouse.exited routine
sketchybar --subscribe mic_slider mouse.clicked mouse.entered mouse.exited

sketchybar --update
