#!/bin/sh

# Clear old items
sketchybar --remove '/.*/' 2>/dev/null

# Bar Configuration (Bottom position for AeroSpace compatibility)
sketchybar --bar position=bottom \
                  height=20 \
                  color=0xff1a1a1a \
                  border_color=0xff333333 \
                  border_width=0 \
                  topmost=window \
                  sticky=on \
                  padding_left=0 \
                  padding_right=0

# Default styling for "pill capsule" widgets
sketchybar --default background.color=0xff333333 \
                      background.corner_radius=4 \
                      background.height=16 \
                      background.padding_left=3 \
                      background.padding_right=3 \
                      label.color=0xffeeeeee \
                      label.font="Hack Nerd Font:Bold:12.0" \
                      icon.font="Hack Nerd Font:Bold:12.0" \
                      label.padding_left=4 \
                      label.padding_right=4

# --- LEFT SIDE ITEMS ---

# AeroSpace workspace handler (invisible)
sketchybar --add event aerospace_workspace_change
sketchybar --add item aerospace_handler left \
           --set aerospace_handler script="$CONFIG_DIR/plugins/aerospace.sh" \
                                 drawing=off
sketchybar --subscribe aerospace_handler aerospace_workspace_change routine

# --- CENTER ITEMS ---

# Gradle Daemons monitor (hidden unless active builds are running).
# Popup of log previews only toggles on mouse click (off by default).
sketchybar --add event gradle_update
sketchybar --add item gradle center \
           --set gradle update_freq=10 \
                          script="$CONFIG_DIR/plugins/gradle/gradle.sh" \
                          drawing=off \
                          popup.drawing=off \
                          icon="" \
                          label.font="Hack Nerd Font:Bold:12.0" \
                          label.color=0xffeeeeee \
                          popup.align=center \
                          popup.blur_radius=8 \
                          popup.background.color=0xff111111
sketchybar --subscribe gradle routine forced system_woke gradle_update mouse.clicked

# --- RIGHT SIDE ITEMS ---

# Clock
sketchybar --add item clock right \
           --set clock update_freq=60 \
                        script="$CONFIG_DIR/plugins/clock.sh" \
                        popup.align=center \
                        popup.blur_radius=8 \
                        popup.background.color=0xff222222
sketchybar --subscribe clock routine mouse.clicked

# Calendar popup items
for i in $(seq 0 9); do
  sketchybar --add item "clock_event_$i" popup.clock \
             --set "clock_event_$i" \
                   drawing=off \
                   icon="·" \
                   icon.padding_left=6 \
                   icon.padding_right=4 \
                   label.padding_right=6 \
                   label.width=580 \
                   width=600 \
                   background.height=20
done

# Battery
sketchybar --add item battery right \
           --set battery update_freq=30 \
                           script="$CONFIG_DIR/plugins/battery.sh"

# WiFi — click opens the macOS Network System Settings pane.
# No popup, no hover. Routine just refreshes the status label.
sketchybar --add item wifi right \
           --set wifi update_freq=10 \
                          script="$CONFIG_DIR/plugins/wifi.sh" \
                          click_script="open x-apple.systempreferences:com.apple.preference.network"
sketchybar --subscribe wifi routine

# Now Playing
# Main media item: shows currently playing track title/artist + popup panel on click.
# No hover: click to toggle popup, click again to dismiss.
sketchybar --add item media right \
           --set media update_freq=10 \
                       script="$CONFIG_DIR/plugins/media.sh" \
                       label.padding_left=6 \
                       icon.padding_right=6 \
                       popup.align=center \
                       popup.blur_radius=8 \
                       popup.background.color=0xff222222
sketchybar --subscribe media media_change routine mouse.clicked

# Popup rows inside `media` popup: previous / play-pause / next
for row in 0 1 2; do
  sketchybar --add item "media_popup_${row}" popup.media \
             --set "media_popup_${row}" \
                   drawing=off \
                   label.font="Hack Nerd Font:Bold:14.0" \
                   label.color=0xffeeeeee \
                   label.align=center \
                   label.padding_left=10 \
                   label.padding_right=10 \
                   label.padding_top=4 \
                   label.padding_bottom=4 \
                   background.color=0xff222222 \
                   background.corner_radius=4 \
                   background.padding_left=4 \
                   background.padding_right=4 \
                   width=240
done

# Keyboard Layout
sketchybar --add item kb_layout right \
           --set kb_layout update_freq=5 \
                           script="$CONFIG_DIR/plugins/kb_layout.sh"
sketchybar --subscribe kb_layout routine mouse.clicked

# Volume + Audio Output (merged, click-only):
#   State 1: text label "{output} >> {volume}%" (popup hidden, slider hidden).
#   State 2 (click text): the label STAYS visible; the slider appears
#           alongside it and a popup lists output devices with the current
#           one marked (● + bold).
#   Click text again to collapse to State 1; click a device row to switch
#           the device and collapse. Dragging the slider updates the
#           system volume and keeps State 2 open.
#
#   IMPORTANT: the anchor item uses an inline `click_script=` (NOT a
#   `--subscribe mouse.clicked`), because sketchybar swallows clicks on
#   anchor items once popup rows are attached — see sketchybar-popup(5).

sketchybar --add item volume right \
    --set volume \
        update_freq=10 \
        script="$CONFIG_DIR/plugins/volume.sh" \
        click_script="$CONFIG_DIR/plugins/volume.sh toggle" \
        icon.drawing=off \
        label="" \
        label.font="Hack Nerd Font:Bold:12.0" \
        label.color=0xffeeeeee \
        label.padding_left=4 \
        label.padding_right=4 \
        popup.align=center \
        popup.blur_radius=8 \
        popup.background.color=0xff222222

# Slider (hidden by default; appears next to the still-visible label when
# the text item is clicked).
sketchybar --add slider volume_slider right 200 \
    --set volume_slider script="$CONFIG_DIR/plugins/volume.sh" \
        slider.knob="●" \
        slider.background.color=0xff555555 \
        slider.height=12 \
        drawing=off

# Output device popup rows (parented to the `volume` anchor). Their visible
# state + `click_script=` are written by `populate_popup` in volume.sh.
for i in $(seq 0 19); do
  sketchybar --add item "volume_output_$i" popup.volume \
      --set "volume_output_$i" \
          drawing=off \
          icon="·" \
          icon.padding_left=6 \
          icon.padding_right=6 \
          label.padding_right=6 \
          label.width=280 \
          width=300 \
          background.height=20
done

# Anchor: only routine + volume_change — NO mouse.clicked here (it doesn't
# fire reliably when popup rows are attached; click_script handles click).
sketchybar --subscribe volume routine volume_change
# Slider supports mouse.clicked events natively (see sketchybar-components(5)).
sketchybar --subscribe volume_slider mouse.clicked volume_change

# Mic Input + Level (merged, click-only): symmetric to volume above.
#   State 1: text label "{mic level}% << {input source}".
#   State 2 (click text): the label STAYS visible; the mic_slider appears
#           alongside it and the popup lists input devices with the
#           current one marked (● + bold).
#   Click text again to collapse; click a device row to switch and collapse.

sketchybar --add item mic right \
    --set mic \
        update_freq=10 \
        script="$CONFIG_DIR/plugins/mic_input.sh" \
        click_script="$CONFIG_DIR/plugins/mic_input.sh toggle" \
        icon.drawing=off \
        label="" \
        label.font="Hack Nerd Font:Bold:12.0" \
        label.color=0xffeeeeee \
        label.padding_left=4 \
        label.padding_right=4 \
        popup.align=center \
        popup.blur_radius=8 \
        popup.background.color=0xff222222

sketchybar --add slider mic_slider right 200 \
    --set mic_slider script="$CONFIG_DIR/plugins/mic_input.sh" \
        slider.knob="●" \
        slider.background.color=0xff555555 \
        slider.height=12 \
        drawing=off

# Mic input popup rows (parented to the `mic` anchor).
for i in $(seq 0 19); do
  sketchybar --add item "mic_input_$i" popup.mic \
      --set "mic_input_$i" \
          drawing=off \
          icon="·" \
          icon.padding_left=6 \
          icon.padding_right=6 \
          label.padding_right=6 \
          label.width=280 \
          width=300 \
          background.height=20
done

sketchybar --subscribe mic routine
sketchybar --subscribe mic_slider mouse.clicked

sketchybar --update
