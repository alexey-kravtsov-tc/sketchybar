#!/bin/sh

# Clear old items
sketchybar --remove '/.*/' 2>/dev/null

# Bar Configuration (Bottom position for AeroSpace compatibility)
sketchybar --bar position=bottom \
                  height=38 \
                  color=0xff1e1e2e \
                  border_color=0xff313244 \
                  border_width=1 \
                  topmost=window \
                  sticky=on \
                  padding_left=10 \
                  padding_right=10

# Default styling for "pill capsule" widgets
sketchybar --default background.color=0xff313244 \
                      background.corner_radius=6 \
                      background.height=26 \
                      label.color=0xffcdd6f4 \
                      label.padding_left=10 \
                      label.padding_right=10

# --- LEFT SIDE ITEMS ---

# AeroSpace Workspace Badge
sketchybar --add item space left \
           --set space update_freq=1 \
                       script="$CONFIG_DIR/plugins/aerospace.sh" \
                       background.color=0xff89b4fa \
                       label.color=0xff11111b

# Open App Name
sketchybar --add item front_app left \
           --set front_app script="$CONFIG_DIR/plugins/front_app.sh" \
                           background.color=0xff181825 \
           --subscribe front_app front_app_switched

# --- RIGHT SIDE ITEMS ---

# Clock
sketchybar --add item clock right \
           --set clock update_freq=10 \
                       script="$CONFIG_DIR/plugins/clock.sh"

# Battery
sketchybar --add item battery right \
           --set battery update_freq=30 \
                         script="$CONFIG_DIR/plugins/battery.sh"

# Volume
sketchybar --add item volume right \
           --set volume update_freq=5 \
                        script="$CONFIG_DIR/plugins/volume.sh"

sketchybar --update
