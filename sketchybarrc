#!/bin/sh

# Clear old items
sketchybar --remove '/.*/' 2>/dev/null

# Bar Configuration (Bottom position for AeroSpace compatibility)
sketchybar --bar position=bottom \
                  height=20 \
                  color=0xff1a1a1a \
                  border_color=0xff333333 \
                  border_width=0 \
                  topmost=window \
                  sticky=on \
                  padding_left=0 \
                  padding_right=0

# Default styling for "pill capsule" widgets
sketchybar --default background.color=0xff333333 \
                      background.corner_radius=4 \
                      background.height=16 \
                      background.padding_left=3 \
                      background.padding_right=3 \
                      label.color=0xffeeeeee \
                      label.font="Hack Nerd Font:Bold:12.0" \
                      icon.font="Hack Nerd Font:Bold:12.0" \
                      label.padding_left=4 \
                      label.padding_right=4

# --- LEFT SIDE ITEMS ---

# AeroSpace workspace handler (invisible)
sketchybar --add event aerospace_workspace_change
sketchybar --add item aerospace_handler left \
           --set aerospace_handler script="$CONFIG_DIR/plugins/aerospace.sh" \
                                 drawing=off
sketchybar --subscribe aerospace_handler aerospace_workspace_change routine

# --- RIGHT SIDE ITEMS ---

# Clock
sketchybar --add item clock right \
           --set clock update_freq=300 \
                        script="$CONFIG_DIR/plugins/clock.sh" \
                        popup.align=center \
                        popup.blur_radius=8 \
                        popup.background.color=0xff222222 \
                        popup.width=600
sketchybar --subscribe clock mouse.entered mouse.exited mouse.clicked

# Calendar popup items
for i in $(seq 0 9); do
  sketchybar --add item "clock_event_$i" popup.clock \
             --set "clock_event_$i" \
                   drawing=off \
                   icon="·" \
                   icon.padding_left=6 \
                   icon.padding_right=4 \
                   label.padding_right=6 \
                   label.width=580 \
                   width=600 \
                   background.height=20
done

# Battery
sketchybar --add item battery right \
           --set battery update_freq=30 \
                           script="$CONFIG_DIR/plugins/battery.sh"
sketchybar --subscribe battery mouse.entered mouse.exited

# WiFi
sketchybar --add item wifi right \
           --set wifi update_freq=10 \
                          script="$CONFIG_DIR/plugins/wifi.sh" \
                          click_script="open x-apple.systempreferences:com.apple.preference.network"
sketchybar --subscribe wifi mouse.entered mouse.exited

# Now Playing
sketchybar --add item media_next right \
           --set media_next script="$CONFIG_DIR/plugins/media_next.sh" \
                       icon="⏭" \
                       label.padding_left=2
sketchybar --subscribe media_next media_change routine mouse.entered mouse.exited mouse.clicked

sketchybar --add item media right \
           --set media update_freq=10 \
                       script="$CONFIG_DIR/plugins/media.sh" \
                       label.padding_left=6 \
                       icon.padding_right=6
sketchybar --subscribe media media_change routine mouse.entered mouse.exited mouse.clicked

sketchybar --add item media_prev right \
           --set media_prev script="$CONFIG_DIR/plugins/media_prev.sh" \
                       icon="⏮" \
                       label.padding_left=2
sketchybar --subscribe media_prev media_change routine mouse.entered mouse.exited mouse.clicked

# Keyboard Layout
sketchybar --add item kb_layout right \
           --set kb_layout update_freq=5 \
                           script="$CONFIG_DIR/plugins/kb_layout.sh"
sketchybar --subscribe kb_layout mouse.entered mouse.exited mouse.clicked

# Volume Slider (using volume_change event and slider component)

sketchybar --add slider volume_slider right 100 \
    --set volume_slider script="$CONFIG_DIR/plugins/volume.sh" \
        slider.knob="●" \
        slider.background.color=0xff555555 \
        slider.height=12 \
        label.font="Hack Nerd Font:Bold:12.0" \
        label.color=0xffeeeeee \
        label.padding_left=4 \
        label.padding_right=4
sketchybar --subscribe volume_slider volume_change mouse.clicked

# Audio Output (current device label + popup list for switching)
sketchybar --add item audio_output right \
    --set audio_output update_freq=10 \
        script="$CONFIG_DIR/plugins/audio_output.sh" \
        icon="" \
        popup.align=center \
        popup.blur_radius=8 \
        popup.background.color=0xff222222 \
        popup.width=300
sketchybar --subscribe audio_output mouse.entered mouse.exited routine

# Audio Output popup items (up to 20 devices)
for i in $(seq 0 19); do
  sketchybar --add item "audio_output_$i" popup.audio_output \
      --set "audio_output_$i" \
          drawing=off \
          icon="·" \
          icon.padding_left=6 \
          icon.padding_right=4 \
          label.padding_right=6 \
          label.width=280 \
          width=300 \
          background.height=20
  sketchybar --subscribe "audio_output_$i" mouse.exited
done

# Mic Input (current device label + popup list with mute option)
sketchybar --add item mic_input right \
    --set mic_input update_freq=10 \
        script="$CONFIG_DIR/plugins/mic_input.sh" \
        icon="" \
        popup.align=center \
        popup.blur_radius=8 \
        popup.background.color=0xff222222 \
        popup.width=300
sketchybar --subscribe mic_input mouse.entered mouse.exited routine

# Mic Input popup items (up to 20 slots)
for i in $(seq 0 19); do
  sketchybar --add item "mic_input_$i" popup.mic_input \
      --set "mic_input_$i" \
          drawing=off \
          icon="·" \
          icon.padding_left=6 \
          icon.padding_right=4 \
          label.padding_right=6 \
          label.width=280 \
          width=300 \
          background.height=20
  sketchybar --subscribe "mic_input_$i" mouse.exited
done

sketchybar --update
