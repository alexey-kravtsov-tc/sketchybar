#!/bin/sh

# Clear old items
sketchybar --remove '/.*/' 2>/dev/null

# Bar Configuration (Bottom position for AeroSpace compatibility)
sketchybar --bar position=bottom \
                  height=20 \
                  color=0xff1a1a1a \
                  border_color=0xff333333 \
                  border_width=0 \
                  topmost=window \
                  sticky=on \
                  padding_left=0 \
                  padding_right=0

# Default styling for "pill capsule" widgets
sketchybar --default background.color=0xff333333 \
                      background.corner_radius=4 \
                      background.height=16 \
                      label.color=0xffeeeeee \
                      label.font="Hack Nerd Font:Bold:12.0" \
                      icon.font="Hack Nerd Font:Bold:12.0" \
                      label.padding_left=4 \
                      label.padding_right=4

# --- LEFT SIDE ITEMS ---

# AeroSpace workspace badge
sketchybar --add item space left \
           --set space update_freq=1 \
                        script="$CONFIG_DIR/plugins/aerospace.sh"

# --- RIGHT SIDE ITEMS ---

# Clock
sketchybar --add item clock right \
           --set clock update_freq=10 \
                       script="$CONFIG_DIR/plugins/clock.sh"

# Battery
sketchybar --add item battery right \
           --set battery update_freq=30 \
                         script="$CONFIG_DIR/plugins/battery.sh"

# Volume
sketchybar --add item volume right \
           --set volume update_freq=5 \
                        script="$CONFIG_DIR/plugins/volume.sh"

sketchybar --update
